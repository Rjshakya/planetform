{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planetform-app",
  "main": "./worker/app.ts",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "planetform.xyz",
    },
    {
      "custom_domain":false,
      "pattern":"*/*",
      "zone_name":"planetform.xyz"
       
    }
  ],
}
